# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Кому слать уведомления о записях: chat id админа (узнать у @userinfobot).
# Несколько админов — через запятую: 123456789,987654321
ADMIN_CHAT_ID=123456789
DB_PATH=bookings.db

# Часовой пояс салона: по нему считаются свободное время и напоминания
TIMEZONE=Asia/Tomsk

# Файл с услугами, мастерами и графиками работы
SALON_CONFIG=salon.toml
